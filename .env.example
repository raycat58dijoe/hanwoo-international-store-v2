# Stripe (cross-border payments). Leave blank to run in DEMO mode
# (checkout creates a paid order locally without a real charge).
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin password for the /admin product panel (default below)
ADMIN_KEY=admin123

# Public site URL (used for Stripe success/cancel redirects & canonical links)
# Set this to your production domain when deployed.
NEXT_PUBLIC_SITE_URL=https://hanwoointernationalinc.net
